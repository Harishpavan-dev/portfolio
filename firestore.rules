rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // PUBLIC READ — Anyone can view published/visible content
    match /projects/{doc} {
      allow read: if resource.data.isVisible == true;
      allow write: if request.auth != null;
    }
    match /services/{doc} {
      allow read: if resource.data.isVisible == true;
      allow write: if request.auth != null;
    }
    match /education/{doc} {
      allow read: if resource.data.isVisible == true;
      allow write: if request.auth != null;
    }
    match /blog_posts/{doc} {
      allow read: if resource.data.isPublished == true;
      allow write: if request.auth != null;
    }
    match /testimonials/{doc} {
      allow read: if resource.data.isVisible == true;
      allow write: if request.auth != null;
    }
    match /site_config/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // WRITE ONLY — Visitors can submit contact messages, only admin reads
    match /messages/{doc} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // ADMIN ONLY — Full access for analytics and chat logs
    match /analytics/{doc} {
      allow read, write: if request.auth != null;
    }
    match /chat_logs/{doc} {
      allow read, write: if request.auth != null;
    }
  }
}
